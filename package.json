{
  "name": "putt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "build:cloudflare": "PUTT_BASE=/ npm run build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply putt-ranking --local",
    "db:migrate": "wrangler d1 migrations apply putt-ranking --remote",
    "validate:course": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/validate-course.ts",
    "validate:challenge": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/validate-challenge.ts",
    "verify:records": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/verify-records.ts",
    "check:stuck": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/check-stuck.ts",
    "maps": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/course-maps.ts",
    "font:pixel": "node scripts/build-pixel-font.mjs",
    "survey:holes": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/survey-holes.ts",
    "survey:v2": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/survey-v2.ts",
    "social:solve": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/solve-social-shot.ts"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.129.0"
  }
}
